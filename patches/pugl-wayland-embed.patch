new file mode 100644
index 0000000..796a4b3
--- /dev/null
+++ b/include/pugl/wayland.h
@@ -0,0 +1,63 @@
+// Copyright 2026 David Robillard <d@drobilla.net>
+// SPDX-License-Identifier: ISC
+
+#ifndef PUGL_WAYLAND_H
+#define PUGL_WAYLAND_H
+
+#include <pugl/attributes.h>
+#include <pugl/pugl.h>
+
+struct wl_display;
+
+PUGL_BEGIN_DECLS
+
+/**
+   @defgroup pugl_wayland Wayland
+   Wayland-specific functions.
+   @ingroup pugl
+   @{
+*/
+
+/**
+   Create a new world on an existing Wayland connection.
+
+   This is for plugins, whose host gives them the connection to use, for
+   example its own nested compositor.  The world doesn't own the connection:
+   the caller disconnects it after freeing the world.
+
+   @param type The type, which dictates what this world is responsible for.
+   @param flags Flags to control world features.
+   @param display The connection, which must outlive the world.
+   @return A new world, which must be later freed with puglFreeWorld().
+*/
+PUGL_MALLOC_API PuglWorld*
+puglNewWaylandWorld(PuglWorldType      type,
+                    PuglWorldFlags     flags,
+                    struct wl_display* display);
+
+/**
+   Embed a view into a surface of the host, with the clap_surface_embedding_v1
+   protocol (https://github.com/free-audio/clap-wayland-experiment).
+
+   This replaces puglSetParent(), since Wayland has no global window handles:
+   the host gives a token instead, which names a place in its window.  It must
+   be called before the view is realized.
+
+   An embedded view has a size in logical pixels, which is its default size,
+   and draws at the scale of the compositor: its configured size is the
+   logical one times puglGetScaleFactor().  When the scale changes, the view
+   gets a new configuration.
+
+   @return #PUGL_BAD_CALL if the view is already realized.  If the compositor
+   can't embed, puglRealize() fails with #PUGL_UNSUPPORTED.
+*/
+PUGL_API PuglStatus
+puglSetWaylandEmbeddingToken(PuglView* view, const char* token);
+
+/**
+   @}
+*/
+
+PUGL_END_DECLS
+
+#endif // PUGL_WAYLAND_H
