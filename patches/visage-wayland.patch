+#pragma once
+
+// A plugin window embedded into a host application's window on Wayland, through the host's
+// nested compositor and the clap_surface_embedding_v1 protocol (see
+// https://github.com/free-audio/clap-wayland-experiment).
+//
+// The caller connects to the host's compositor and gives us the wl_display, which several windows
+// may share. bgfx is global to the process and draws on one wl_display only, so all the windows of
+// the process must use the same one.
+
+#if VISAGE_LINUX && VISAGE_WAYLAND
+#include "windowing.h"
+
+#include <string>
+
+struct clap_embedded_surface_v1;
+struct wl_callback;
+struct wl_display;
+struct wl_surface;
+struct wp_fractional_scale_v1;
+struct wp_viewport;
+
+namespace visage {
+  class WaylandConnection;
+
+  class WindowWayland : public Window {
+  public:
+    static constexpr int kTimerMs = 16;
+
+    // width and height are in logical pixels, as the host gave them
+    WindowWayland(int width, int height, wl_display* display, const std::string& token);
+    ~WindowWayland() override;
+
+    bool isEmbedded() const { return embedded_surface_ != nullptr; }
+
+    void runEventLoop() override;
+    void* nativeHandle() const override { return surface_; }
+    void windowContentsResized(int width, int height) override;
+
+    void* initWindow() const override;
+    void* globalDisplay() const override { return display_; }
+    bool usesWayland() const override { return true; }
+    void processPluginFdEvents() override;
+    int posixFd() const override { return epoll_fd_; }
+
+    void show() override;
+    void showMaximized() override { show(); }
+    void hide() override;
+    void close() override { hide(); }
+    bool isShowing() const override { return showing_; }
+    void setWindowTitle(const std::string& title) override { }
+    IPoint maxWindowDimensions() const override { return { 16384, 16384 }; }
+
+  private:
+    friend class WaylandConnection;
+
+    void setScale(double scale);
+    void updateViewport();
+    void onClosed();
+    void tick();
+
+    WaylandConnection* connection_ = nullptr;
+    wl_display* display_ = nullptr;
+    wl_surface* surface_ = nullptr;
