diff --git a/visage_graphics/patch_bgfx.cmake b/visage_graphics/patch_bgfx.cmake
new file mode 100644
index 0000000..4ae5123
--- /dev/null
+++ b/visage_graphics/patch_bgfx.cmake
@@ -0,0 +1,19 @@
+# Applied to bgfx once it is fetched (cmake -DBGFX_SOURCE_DIR=... -P patch_bgfx.cmake).
+#
+# Vulkan: without vsync, take MAILBOX when there is no IMMEDIATE (Mesa on Wayland) rather than
+# falling back to FIFO. FIFO waits for the compositor, which may never come for a window that isn't
+# painted, for example a plugin's window while the host is minimized: the present would block the
+# main thread.
+
+set(FILE "${BGFX_SOURCE_DIR}/bgfx/src/renderer_vk.cpp")
+file(READ "${FILE}" CONTENT)
+set(TAB "\t")
+string(REPLACE
+  "${TAB}${TAB}{ VK_PRESENT_MODE_MAILBOX_KHR,      true,  \"VK_PRESENT_MODE_MAILBOX_KHR\"      },\n${TAB}${TAB}{ VK_PRESENT_MODE_IMMEDIATE_KHR,    false, \"VK_PRESENT_MODE_IMMEDIATE_KHR\"    },"
+  "${TAB}${TAB}{ VK_PRESENT_MODE_IMMEDIATE_KHR,    false, \"VK_PRESENT_MODE_IMMEDIATE_KHR\"    },\n${TAB}${TAB}{ VK_PRESENT_MODE_MAILBOX_KHR,      false, \"VK_PRESENT_MODE_MAILBOX_KHR\"      },"
+  PATCHED "${CONTENT}")
+if (NOT PATCHED STREQUAL CONTENT)
+  file(WRITE "${FILE}" "${PATCHED}")
+elseif (NOT CONTENT MATCHES "VK_PRESENT_MODE_MAILBOX_KHR,      false")
+  message(WARNING "visage: bgfx's present modes have changed, the MAILBOX patch doesn't apply")
+endif ()
