+
+#if VISAGE_LINUX && VISAGE_WAYLAND
+#include "windowing_wayland.h"
+
+#include "visage_utils/time_utils.h"
+
+#include <algorithm>
+#include <cmath>
+#include <cstring>
+#include <linux/input-event-codes.h>
+#include <map>
+#include <memory>
+#include <poll.h>
+#include <sys/epoll.h>
+#include <sys/mman.h>
+#include <sys/timerfd.h>
+#include <unistd.h>
+#include <vector>
+#include <wayland-client.h>
+#include <xkbcommon/xkbcommon.h>
+
+// clang-format off
+#include "fractional-scale-v1-client-protocol.h"
+#include "viewporter-client-protocol.h"
+#include "xdg-shell-client-protocol.h"
+#include "clap-surface-embedding-v1-client-protocol.h" // after xdg-shell's
+// clang-format on
+
+namespace visage {
+  KeyCode translateKeysym(unsigned int keysym); // windowing_x11.cpp
+
+  // What the windows on one wl_display share: its globals and its input. It lives as long as the
+  // process, since bgfx keeps using the display's surfaces until then.
+  class WaylandConnection {
+  public:
+    // A destroyed window's surface stays this many ticks, until bgfx has released its swap chain
+    static constexpr int kRetiredSurfaceTicks = 8;
+
+    static WaylandConnection* forDisplay(wl_display* display) {
+      static std::map<wl_display*, std::unique_ptr<WaylandConnection>> connections;
+      auto& connection = connections[display];
+      if (connection == nullptr)
+        connection.reset(new WaylandConnection(display));
+      return connection.get();
+    }
+
+    wl_compositor* compositor() const { return compositor_; }
+    clap_surface_embedding_v1* embedding() const { return embedding_; }
+    wp_viewporter* viewporter() const { return viewporter_; }
+    wp_fractional_scale_manager_v1* fractionalScaleManager() const {
+      return fractional_scale_manager_;
+    }
+
+    void addWindow(WindowWayland* window) { windows_.push_back(window); }
+
+    void removeWindow(WindowWayland* window) {
+      windows_.erase(std::remove(windows_.begin(), windows_.end(), window), windows_.end());
+      if (pointer_focus_ == window)
+        pointer_focus_ = nullptr;
+      if (keyboard_focus_ == window) {
+        keyboard_focus_ = nullptr;
+        repeat_key_ = 0;
+      }
+    }
+
+    void retireSurface(wl_surface* surface) { retired_surfaces_.push_back({ surface, kRetiredSurfaceTicks }); }
+
+    // The model window for bgfx's initialization, which is never shown
+    wl_surface* modelSurface() {
+      if (model_surface_ == nullptr && compositor_)
+        model_surface_ = wl_compositor_create_surface(compositor_);
+      return model_surface_;
+    }
+
+    // Reads and dispatches the events which are there, without waiting
+    void dispatch() {
+      while (wl_display_prepare_read(display_) != 0)
+        wl_display_dispatch_pending(display_);
+      wl_display_flush(display_);
+
+      pollfd fd = { wl_display_get_fd(display_), POLLIN, 0 };
+      if (poll(&fd, 1, 0) > 0)
+        wl_display_read_events(display_);
+      else
+        wl_display_cancel_read(display_);
+
+      wl_display_dispatch_pending(display_);
+      wl_display_flush(display_);
+    }
+
+    // From the windows' timers: the key repeats, and the retired surfaces
+    void tick() {
+      for (auto it = retired_surfaces_.begin(); it != retired_surfaces_.end();) {
+        if (--it->second > 0) {
+          ++it;
+          continue;
+        }
+        wl_surface_destroy(it->first);
+        it = retired_surfaces_.erase(it);
+      }
+
+      if (repeat_key_ && keyboard_focus_ && repeat_rate_ > 0) {
+        long long now = time::microseconds();
+        while (now >= next_repeat_microseconds_) {
+          next_repeat_microseconds_ += 1000000 / repeat_rate_;
+          keyDown(repeat_key_, true);
+        }
+      }
+    }
+
+  private:
+    explicit WaylandConnection(wl_display* display) : display_(display) {
+      static const wl_registry_listener registry_listener = {
+        .global =
+            [](void* data, wl_registry* registry, uint32_t name, const char* interface, uint32_t version) {
+              static_cast<WaylandConnection*>(data)->onGlobal(registry, name, interface, version);
+            },
+        .global_remove = [](void*, wl_registry*, uint32_t) {},
+      };
+      xkb_context_ = xkb_context_new(XKB_CONTEXT_NO_FLAGS);
+      registry_ = wl_display_get_registry(display_);
+      wl_registry_add_listener(registry_, &registry_listener, this);
+      wl_display_roundtrip(display_);
+      // The seat's capabilities
+      wl_display_roundtrip(display_);
+    }
+
+    WindowWayland* findWindow(wl_surface* surface) const {
+      for (WindowWayland* window : windows_) {
+        if (window->surface_ == surface)
+          return window;
+      }
+      return nullptr;
+    }
+
+    void onGlobal(wl_registry* registry, uint32_t name, const char* interface, uint32_t version) {
+      if (strcmp(interface, wl_compositor_interface.name) == 0 && version >= 4) {
+        compositor_ = static_cast<wl_compositor*>(
+            wl_registry_bind(registry, name, &wl_compositor_interface, std::min(version, 6u)));
+      }
+      else if (strcmp(interface, clap_surface_embedding_v1_interface.name) == 0) {
+        embedding_ = static_cast<clap_surface_embedding_v1*>(
+            wl_registry_bind(registry, name, &clap_surface_embedding_v1_interface, 1));
+      }
+      else if (strcmp(interface, wp_viewporter_interface.name) == 0) {
+        viewporter_ = static_cast<wp_viewporter*>(wl_registry_bind(registry, name, &wp_viewporter_interface, 1));
+      }
+      else if (strcmp(interface, wp_fractional_scale_manager_v1_interface.name) == 0) {
+        fractional_scale_manager_ = static_cast<wp_fractional_scale_manager_v1*>(
+            wl_registry_bind(registry, name, &wp_fractional_scale_manager_v1_interface, 1));
+      }
+      else if (strcmp(interface, wl_seat_interface.name) == 0 && seat_ == nullptr && version >= 5) {
+        static const wl_seat_listener seat_listener = {
+          .capabilities = [](void* data, wl_seat*,
+                             uint32_t capabilities) { static_cast<WaylandConnection*>(data)->onSeat(capabilities); },
+          .name = [](void*, wl_seat*, const char*) {},
+        };
+        seat_ = static_cast<wl_seat*>(wl_registry_bind(registry, name, &wl_seat_interface, 5));
+        wl_seat_add_listener(seat_, &seat_listener, this);
+      }
+    }
+
+    void onSeat(uint32_t capabilities);
+
+    int modifiers() const {
+      if (xkb_state_ == nullptr)
+        return kModifierNone;
+      auto active = [this](const char* name) {
+        return xkb_state_mod_name_is_active(xkb_state_, name, XKB_STATE_MODS_EFFECTIVE) > 0;
+      };
+      int result = kModifierNone;
+      if (active(XKB_MOD_NAME_SHIFT))
+        result |= kModifierShift;
+      if (active(XKB_MOD_NAME_CTRL))
+        result |= kModifierRegCtrl;
+      if (active(XKB_MOD_NAME_ALT))
+        result |= kModifierAlt;
+      if (active(XKB_MOD_NAME_LOGO))
+        result |= kModifierMeta;
+      return result;
+    }
+
+    IPoint nativePointer() const {
+      return pointer_focus_->convertToNative(Point(pointer_x_, pointer_y_));
+    }
+
+    void keyDown(uint32_t keycode, bool repeat) {
+      if (keyboard_focus_ == nullptr || xkb_state_ == nullptr)
+        return;
+
+      int mods = modifiers();
+      char text[32] {};
+      xkb_state_key_get_utf8(xkb_state_, keycode, text, sizeof(text));
+      bool is_text = text[0] && static_cast<unsigned char>(text[0]) >= 0x20 && text[0] != 0x7f;
+      if ((mods & (kModifierRegCtrl | kModifierAlt | kModifierMeta)) == 0 && is_text)
+        keyboard_focus_->handleTextInput(text);
+
+      KeyCode key_code = translateKeysym(xkb_state_key_get_one_sym(xkb_state_, keycode));
+      if (key_code != KeyCode::Unknown)
+        keyboard_focus_->handleKeyDown(key_code, mods, repeat);
+    }
+
+    wl_display* display_ = nullptr;
+    wl_registry* registry_ = nullptr;
+    wl_compositor* compositor_ = nullptr;
+    clap_surface_embedding_v1* embedding_ = nullptr;
+    wp_viewporter* viewporter_ = nullptr;
+    wp_fractional_scale_manager_v1* fractional_scale_manager_ = nullptr;
+    wl_seat* seat_ = nullptr;
+    wl_pointer* pointer_ = nullptr;
+    wl_keyboard* keyboard_ = nullptr;
+    wl_surface* model_surface_ = nullptr;
+
+    std::vector<WindowWayland*> windows_;
+    std::vector<std::pair<wl_surface*, int>> retired_surfaces_;
+
+    WindowWayland* pointer_focus_ = nullptr;
+    double pointer_x_ = 0.0;
+    double pointer_y_ = 0.0;
+    int button_state_ = kMouseButtonNone;
+    float wheel_x_ = 0.0f;
+    float wheel_y_ = 0.0f;
+    bool wheel_discrete_ = false;
+
+    xkb_context* xkb_context_ = nullptr;
+    xkb_keymap* xkb_keymap_ = nullptr;
+    xkb_state* xkb_state_ = nullptr;
+    WindowWayland* keyboard_focus_ = nullptr;
+    uint32_t repeat_key_ = 0;
+    int repeat_rate_ = 25;
+    int repeat_delay_ = 600;
+    long long next_repeat_microseconds_ = 0;
+  };
+
+  static MouseButton mouseButtonFromWayland(uint32_t button) {
+    switch (button) {
+    case BTN_LEFT: return kMouseButtonLeft;
+    case BTN_MIDDLE: return kMouseButtonMiddle;
+    case BTN_RIGHT: return kMouseButtonRight;
+    default: return kMouseButtonNone;
+    }
+  }
+
+  void WaylandConnection::onSeat(uint32_t capabilities) {
+    static const wl_pointer_listener pointer_listener = {
+      .enter =
+          [](void* data, wl_pointer*, uint32_t, wl_surface* surface, wl_fixed_t x, wl_fixed_t y) {
+            auto c = static_cast<WaylandConnection*>(data);
+            c->pointer_focus_ = c->findWindow(surface);
+            c->pointer_x_ = wl_fixed_to_double(x);
+            c->pointer_y_ = wl_fixed_to_double(y);
+            if (c->pointer_focus_) {
+              IPoint p = c->nativePointer();
+              c->pointer_focus_->handleMouseEnter(p.x, p.y);
+            }
+          },
+      .leave =
+          [](void* data, wl_pointer*, uint32_t, wl_surface*) {
+            auto c = static_cast<WaylandConnection*>(data);
+            if (c->pointer_focus_)
+              c->pointer_focus_->handleMouseLeave(c->button_state_, c->modifiers());
+            c->pointer_focus_ = nullptr;
+            c->button_state_ = kMouseButtonNone;
+          },
+      .motion =
+          [](void* data, wl_pointer*, uint32_t, wl_fixed_t x, wl_fixed_t y) {
+            auto c = static_cast<WaylandConnection*>(data);
+            c->pointer_x_ = wl_fixed_to_double(x);
+            c->pointer_y_ = wl_fixed_to_double(y);
+            if (c->pointer_focus_) {
+              IPoint p = c->nativePointer();
+              c->pointer_focus_->handleMouseMove(p.x, p.y, c->button_state_, c->modifiers());
+            }
+          },
+      .button =
+          [](void* data, wl_pointer*, uint32_t, uint32_t, uint32_t button, uint32_t state) {
+            auto c = static_cast<WaylandConnection*>(data);
+            MouseButton mouse_button = mouseButtonFromWayland(button);
+            if (c->pointer_focus_ == nullptr || mouse_button == kMouseButtonNone)
+              return;
+
+            IPoint p = c->nativePointer();
+            if (state == WL_POINTER_BUTTON_STATE_PRESSED) {
+              c->button_state_ |= mouse_button;
+              c->pointer_focus_->handleMouseDown(mouse_button, p.x, p.y, c->button_state_, c->modifiers());
+            }
+            else {
+              c->button_state_ &= ~mouse_button;
+              c->pointer_focus_->handleMouseUp(mouse_button, p.x, p.y, c->button_state_, c->modifiers());
+            }
+          },
+      .axis =
+          [](void* data, wl_pointer*, uint32_t, uint32_t axis, wl_fixed_t value) {
+            // Smooth scrolling, about 10 per notch: down and right are positive
+            auto c = static_cast<WaylandConnection*>(data);
+            if (c->wheel_discrete_)
+              return;
+            float delta = -static_cast<float>(wl_fixed_to_double(value)) / 10.0f;
+            if (axis == WL_POINTER_AXIS_VERTICAL_SCROLL)
+              c->wheel_y_ += delta;
+            else
+              c->wheel_x_ += delta;
+          },
+      .frame =
+          [](void* data, wl_pointer*) {
+            auto c = static_cast<WaylandConnection*>(data);
+            if (c->pointer_focus_ && (c->wheel_x_ != 0.0f || c->wheel_y_ != 0.0f)) {
+              IPoint p = c->nativePointer();
+              c->pointer_focus_->handleMouseWheel(c->wheel_x_, c->wheel_y_, p.x, p.y,
+                                                  c->button_state_, c->modifiers());
+            }
+            c->wheel_x_ = c->wheel_y_ = 0.0f;
+            c->wheel_discrete_ = false;
+          },
+      .axis_source = [](void*, wl_pointer*, uint32_t) {},
+      .axis_stop = [](void*, wl_pointer*, uint32_t, uint32_t) {},
+      .axis_discrete =
+          [](void* data, wl_pointer*, uint32_t axis, int32_t discrete) {
+            // A mouse wheel's notches, which come before their axis event
+            auto c = static_cast<WaylandConnection*>(data);
+            if (!c->wheel_discrete_)
+              c->wheel_x_ = c->wheel_y_ = 0.0f;
+            c->wheel_discrete_ = true;
+            if (axis == WL_POINTER_AXIS_VERTICAL_SCROLL)
+              c->wheel_y_ -= discrete;
+            else
+              c->wheel_x_ -= discrete;
+          },
+    };
+
+    static const wl_keyboard_listener keyboard_listener = {
+      .keymap =
+          [](void* data, wl_keyboard*, uint32_t format, int32_t fd, uint32_t size) {
+            auto c = static_cast<WaylandConnection*>(data);
+            if (format != WL_KEYBOARD_KEYMAP_FORMAT_XKB_V1) {
+              close(fd);
+              return;
+            }
+            void* map = mmap(nullptr, size, PROT_READ, MAP_PRIVATE, fd, 0);
+            close(fd);
+            if (map == MAP_FAILED)
+              return;
+
+            xkb_keymap* keymap = xkb_keymap_new_from_string(c->xkb_context_, static_cast<const char*>(map),
+                                                            XKB_KEYMAP_FORMAT_TEXT_V1,
+                                                            XKB_KEYMAP_COMPILE_NO_FLAGS);
+            munmap(map, size);
+            if (keymap == nullptr)
+              return;
+
+            xkb_state_unref(c->xkb_state_);
+            xkb_keymap_unref(c->xkb_keymap_);
+            c->xkb_keymap_ = keymap;
+            c->xkb_state_ = xkb_state_new(keymap);
+          },
+      .enter =
+          [](void* data, wl_keyboard*, uint32_t, wl_surface* surface, wl_array*) {
+            auto c = static_cast<WaylandConnection*>(data);
+            c->keyboard_focus_ = c->findWindow(surface);
+            if (c->keyboard_focus_)
+              c->keyboard_focus_->handleFocusGained();
+          },
+      .leave =
+          [](void* data, wl_keyboard*, uint32_t, wl_surface*) {
+            auto c = static_cast<WaylandConnection*>(data);
+            if (c->keyboard_focus_)
+              c->keyboard_focus_->handleFocusLost();
+            c->keyboard_focus_ = nullptr;
+            c->repeat_key_ = 0;
+          },
+      .key =
+          [](void* data, wl_keyboard*, uint32_t, uint32_t, uint32_t key, uint32_t state) {
+            auto c = static_cast<WaylandConnection*>(data);
+            if (c->keyboard_focus_ == nullptr || c->xkb_state_ == nullptr)
+              return;
+
+            uint32_t keycode = key + 8;
+            if (state == WL_KEYBOARD_KEY_STATE_PRESSED) {
+              c->keyDown(keycode, false);
+              if (xkb_keymap_key_repeats(c->xkb_keymap_, keycode)) {
+                c->repeat_key_ = keycode;
+                c->next_repeat_microseconds_ = time::microseconds() + c->repeat_delay_ * 1000LL;
+              }
+            }
+            else {
+              if (c->repeat_key_ == keycode)
+                c->repeat_key_ = 0;
+              KeyCode key_code = translateKeysym(xkb_state_key_get_one_sym(c->xkb_state_, keycode));
+              if (key_code != KeyCode::Unknown)
+                c->keyboard_focus_->handleKeyUp(key_code, c->modifiers());
+            }
+          },
+      .modifiers =
+          [](void* data, wl_keyboard*, uint32_t, uint32_t depressed, uint32_t latched, uint32_t locked,
+             uint32_t group) {
+            auto c = static_cast<WaylandConnection*>(data);
+            if (c->xkb_state_)
+              xkb_state_update_mask(c->xkb_state_, depressed, latched, locked, 0, 0, group);
+          },
+      .repeat_info =
+          [](void* data, wl_keyboard*, int32_t rate, int32_t delay) {
+            auto c = static_cast<WaylandConnection*>(data);
+            c->repeat_rate_ = rate;
+            c->repeat_delay_ = delay;
+          },
+    };
+
+    if ((capabilities & WL_SEAT_CAPABILITY_POINTER) && pointer_ == nullptr) {
+      pointer_ = wl_seat_get_pointer(seat_);
+      wl_pointer_add_listener(pointer_, &pointer_listener, this);
+    }
+    if ((capabilities & WL_SEAT_CAPABILITY_KEYBOARD) && keyboard_ == nullptr) {
+      keyboard_ = wl_seat_get_keyboard(seat_);
+      wl_keyboard_add_listener(keyboard_, &keyboard_listener, this);
+    }
+  }
+
+  std::unique_ptr<Window> createWaylandEmbeddedWindow(int width, int height, void* display,
+                                                      const std::string& token) {
+    auto window = std::make_unique<WindowWayland>(width, height, static_cast<wl_display*>(display), token);
+    if (!window->isEmbedded())
+      return nullptr;
+    return window;
+  }
+
+  WindowWayland::WindowWayland(int width, int height, wl_display* display, const std::string& token) :
+      Window(width, height), display_(display), logical_width_(width), logical_height_(height) {
+    static const wl_surface_listener surface_listener = {
+      .enter = [](void*, wl_surface*, wl_output*) {},
+      .leave = [](void*, wl_surface*, wl_output*) {},
+      .preferred_buffer_scale =
+          [](void* data, wl_surface*, int32_t factor) {
+            // Until a fractional scale comes, if ever
+            auto window = static_cast<WindowWayland*>(data);
+            if (!window->has_fractional_scale_)
+              window->setScale(factor);
+          },
+      .preferred_buffer_transform = [](void*, wl_surface*, uint32_t) {},
+    };
+    static const wp_fractional_scale_v1_listener fractional_scale_listener = {
+      .preferred_scale =
+          [](void* data, wp_fractional_scale_v1*, uint32_t scale120) {
+            auto window = static_cast<WindowWayland*>(data);
+            window->has_fractional_scale_ = true;
+            window->setScale(scale120 / 120.0);
+          },
+    };
+    static const clap_embedded_surface_v1_listener embedded_listener = {
+      .position = [](void*, clap_embedded_surface_v1*, int32_t, int32_t) {},
+      .closed = [](void* data, clap_embedded_surface_v1*) { static_cast<WindowWayland*>(data)->onClosed(); },
+    };
+
+    connection_ = WaylandConnection::forDisplay(display_);
+    if (connection_->compositor() == nullptr || connection_->embedding() == nullptr) {
+      VISAGE_LOG("The Wayland compositor can't embed: it has no clap_surface_embedding_v1");
+      return;
+    }
+
+    surface_ = wl_compositor_create_surface(connection_->compositor());
+    wl_surface_add_listener(surface_, &surface_listener, this);
+    if (connection_->viewporter()) {
+      viewport_ = wp_viewporter_get_viewport(connection_->viewporter(), surface_);
+      if (connection_->fractionalScaleManager()) {
+        fractional_scale_ = wp_fractional_scale_manager_v1_get_fractional_scale(connection_->fractionalScaleManager(),
+                                                                                surface_);
+        wp_fractional_scale_v1_add_listener(fractional_scale_, &fractional_scale_listener, this);
+      }
+    }
+
+    embedded_surface_ = clap_surface_embedding_v1_get_embedded_surface(connection_->embedding(), surface_,
+                                                                       token.c_str());
+    clap_embedded_surface_v1_add_listener(embedded_surface_, &embedded_listener, this);
+    connection_->addWindow(this);
+
+    // The compositor tells the scale, or closes the embedding right away
+    wl_display_roundtrip(display_);
+    setDpiScale(scale_);
+    handleResized(std::round(logical_width_ * scale_), std::round(logical_height_ * scale_));
+    updateViewport();
+
+    epoll_fd_ = epoll_create1(EPOLL_CLOEXEC);
+    timer_fd_ = timerfd_create(CLOCK_MONOTONIC, TFD_NONBLOCK | TFD_CLOEXEC);
+    epoll_event event = {};
+    event.events = EPOLLIN;
+    event.data.fd = wl_display_get_fd(display_);
+    epoll_ctl(epoll_fd_, EPOLL_CTL_ADD, event.data.fd, &event);
+    event.data.fd = timer_fd_;
+    epoll_ctl(epoll_fd_, EPOLL_CTL_ADD, timer_fd_, &event);
+
+    start_microseconds_ = time::microseconds();
+  }
+
+  WindowWayland::~WindowWayland() {
+    if (connection_)
+      connection_->removeWindow(this);
+    if (fractional_scale_)
+      wp_fractional_scale_v1_destroy(fractional_scale_);
+    if (viewport_)
+      wp_viewport_destroy(viewport_);
+    if (embedded_surface_)
+      clap_embedded_surface_v1_destroy(embedded_surface_);
+    if (surface_) {
+      // bgfx releases the swap chain on this surface a few frames later
+      wl_surface_attach(surface_, nullptr, 0, 0);
+      wl_surface_commit(surface_);
+      connection_->retireSurface(surface_);
+    }
+    if (display_)
+      wl_display_flush(display_);
+    if (timer_fd_ >= 0)
+      ::close(timer_fd_);
+    if (epoll_fd_ >= 0)
+      ::close(epoll_fd_);
+  }
+
+  void* WindowWayland::initWindow() const {
+    return connection_ ? connection_->modelSurface() : nullptr;
+  }
+
+  void WindowWayland::setScale(double scale) {
+    if (scale <= 0.0 || scale == scale_)
+      return;
+
+    scale_ = scale;
+    // During construction, the constructor applies it
+    if (epoll_fd_ < 0)
+      return;
+
+    setDpiScale(scale_);
+    updateViewport();
+    handleResized(std::round(logical_width_ * scale_), std::round(logical_height_ * scale_));
+  }
+
+  // The swap chain's buffers have the native size: the compositor scales them to the logical one
+  void WindowWayland::updateViewport() {
+    if (viewport_)
+      wp_viewport_set_destination(viewport_, logical_width_, logical_height_);
+    else
+      wl_surface_set_buffer_scale(surface_, std::max(1, static_cast<int>(std::round(scale_))));
+  }
+
+  void WindowWayland::windowContentsResized(int width, int height) {
+    if (surface_ == nullptr)
+      return;
+    logical_width_ = std::round(width / scale_);
+    logical_height_ = std::round(height / scale_);
+    updateViewport();
+  }
+
+  void WindowWayland::onClosed() {
+    VISAGE_LOG("The host ended the embedding");
+    hide();
+    clap_embedded_surface_v1_destroy(embedded_surface_);
+    embedded_surface_ = nullptr;
+  }
+
+  void WindowWayland::tick() {
+    connection_->tick();
+    if (showing_ && isVisible())
+      drawCallback((time::microseconds() - start_microseconds_) / 1000000.0);
+  }
+
+  void WindowWayland::processPluginFdEvents() {
+    if (connection_ == nullptr)
+      return;
+
+    connection_->dispatch();
+    uint64_t expirations = 0;
+    if (read(timer_fd_, &expirations, sizeof(expirations)) == sizeof(expirations))
+      tick();
+  }
+
+  void WindowWayland::runEventLoop() {
+    while (showing_) {
+      pollfd fd = { epoll_fd_, POLLIN, 0 };
+      poll(&fd, 1, -1);
+      processPluginFdEvents();
+    }
+  }
+
+  void WindowWayland::show() {
+    if (showing_ || embedded_surface_ == nullptr)
+      return;
+
+    showing_ = true;
+    setVisible(true);
+    itimerspec spec = {};
+    spec.it_interval.tv_nsec = kTimerMs * 1000000L;
+    spec.it_value.tv_nsec = kTimerMs * 1000000L;
+    timerfd_settime(timer_fd_, 0, &spec, nullptr);
+    handleWindowShown();
+  }
+
+  void WindowWayland::hide() {
+    if (!showing_)
+      return;
+
+    showing_ = false;
+    setVisible(false);
+    itimerspec spec = {};
+    timerfd_settime(timer_fd_, 0, &spec, nullptr);
+    // Unmapped until the next frame
+    wl_surface_attach(surface_, nullptr, 0, 0);
+    wl_surface_commit(surface_);
+    wl_display_flush(display_);
+    handleWindowHidden();
+  }
+}
+
+#endif
